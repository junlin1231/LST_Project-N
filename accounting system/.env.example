# Copy this file to .env before sharing or deploying with Docker Compose.
# Use a long unique password; do not commit the resulting .env file.
POSTGRES_DB=accounting
POSTGRES_USER=accounting
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional AI OCR settings. Leave URL and BEARER_TOKEN blank to use local fallback OCR.
URL=
LLM_MODEL=gemma-4
LLM_PROVIDER=openai
BEARER_TOKEN=
OCR_OWN_NAMES=Demo Company
