DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
AUTH_SHARED_SECRET=replace-with-same-secret-as-accounting-system
ACCOUNTING_APP_URL=http://localhost:3000
ACCESS_COOKIE_NAME=lst_access_token
ACCESS_COOKIE_MAX_AGE=43200

# Leave DATABASE_URL empty to use local SQLite outside Docker.
# For PostgreSQL, use:
# DATABASE_URL=postgres://accounting:accounting@127.0.0.1:5432/accounting
DATABASE_URL=

# Docker bootstrap admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Demo Admin
